# =============================================================================
# Semantic Cache - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values. Never commit .env to git.

# --- LLM Service ---
# Provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini
# Your Gemini API key from https://aistudio.google.com/
LLM_API_KEY=your_gemini_api_key_here
# Optional: override the default model (gemini-pro)
# LLM_MODEL=gemini-1.5-flash

# --- API ---
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# --- Redis ---
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Database ---
# DATABASE_URL=sqlite:///./semantic_cache.db

# --- Embedding ---
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=local

# --- Similarity ---
# SIMILARITY_THRESHOLD=0.85

# --- Logging ---
# LOG_LEVEL=INFO
